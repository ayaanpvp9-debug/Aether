# ─────────────────────────────────────────────────────────────
# VELTRIX server configuration (copy to .env — never commit .env)
# All values are optional; sensible defaults are used.
# ─────────────────────────────────────────────────────────────

# Production server (npm start). Hosts like Render inject PORT themselves.
PORT=3000
HOST=0.0.0.0

# Build-time public origin for absolute social-preview URLs (og:image, og:url,
# canonical). Optional: Render's RENDER_EXTERNAL_URL is used automatically.
# Set it when you add a custom domain, e.g. https://veltrix.example
SITE_URL=
