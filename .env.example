# ─────────────────────────────────────────────────────────────
# VELTRIX server configuration (copy to .env — never commit .env)
# All values are optional; sensible defaults are used.
# ─────────────────────────────────────────────────────────────

# Production server (npm start). Hosts like Render inject PORT themselves.
PORT=3000
HOST=0.0.0.0

# Where inquiries are persisted. Created automatically.
# On Render this must be a persistent disk's mount path (e.g. /var/data),
# otherwise the data is wiped on every redeploy/restart/spin-down.
DATA_DIR=./data

# Storage driver: auto | sqlite | file
#   auto   → SQLite via node:sqlite (Node ≥ 22.13), falls back to JSONL file
#   sqlite → require SQLite (fails fast if unavailable)
#   file   → append-only JSON Lines file (data/inquiries.jsonl)
INQUIRY_STORE=auto

# Enables GET /api/inquiries (Authorization: Bearer <token>).
# Leave empty to keep the endpoint disabled. Must be ≥ 24 characters.
ADMIN_TOKEN=

# Rate limiting for POST /api/inquiries (per client IP)
RATE_LIMIT_MAX=8
RATE_LIMIT_WINDOW_MS=900000

# Client IP for rate limiting — pick ONE (empty/false = TCP peer address):
#   CLIENT_IP_HEADER → a header your hosting edge always overwrites
#                      (Render: true-client-ip — set by render.yaml).
#   TRUST_PROXY      → number of trusted proxies in front of the app (true = 1);
#                      X-Forwarded-For is read from the right, never the left.
CLIENT_IP_HEADER=
TRUST_PROXY=false

# Optional comma-separated allow-list of origins permitted to POST
# (e.g. https://veltrix.example). Empty = same-origin browser requests only.
ALLOWED_ORIGINS=

# Build-time public origin for absolute social-preview URLs (og:image, og:url,
# canonical). Optional: Render's RENDER_EXTERNAL_URL is used automatically.
# Set it when you add a custom domain, e.g. https://veltrix.example
SITE_URL=
