# ─────────────────────────────────────────────────────────────
# VELTRIX server configuration (copy to .env — never commit .env)
# All values are optional; sensible defaults are used.
# ─────────────────────────────────────────────────────────────

# Production server (npm start)
PORT=3000
HOST=0.0.0.0

# Where inquiries are persisted. Created automatically.
DATA_DIR=./data

# Storage driver: auto | sqlite | file
#   auto   → SQLite via node:sqlite (Node ≥ 22.13), falls back to JSONL file
#   sqlite → require SQLite (fails fast if unavailable)
#   file   → append-only JSON Lines file (data/inquiries.jsonl)
INQUIRY_STORE=auto

# Enables GET /api/inquiries (Authorization: Bearer <token>).
# Leave empty to keep the endpoint disabled. Must be ≥ 24 characters.
ADMIN_TOKEN=

# Rate limiting for POST /api/inquiries (per client IP)
RATE_LIMIT_MAX=8
RATE_LIMIT_WINDOW_MS=900000

# Set to true only when running behind a trusted reverse proxy
# (uses the first X-Forwarded-For address as the client IP).
TRUST_PROXY=false

# Optional comma-separated allow-list of origins permitted to POST
# (e.g. https://veltrix.example). Empty = same-origin browser requests only.
ALLOWED_ORIGINS=
